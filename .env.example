# Copy to .env.local for local development. On Vercel, add these under
# Project -> Settings -> Environment Variables.

# Supabase -> Project Settings -> Data API -> "Project URL"
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase -> Project Settings -> API Keys -> secret key (starts with sb_secret_)
# or, on the "Legacy" tab, the service_role key. Server-only; never add a
# NEXT_PUBLIC_ prefix to this variable.
SUPABASE_SERVICE_ROLE_KEY=

# Resend -> API Keys -> Create API Key (starts with re_)
RESEND_API_KEY=

# Sender shown to recipients. Until a domain is verified in Resend, only
# onboarding@resend.dev is accepted, and it only delivers to the email on your
# Resend account. After verifying a domain, change to e.g.
# "Brad's Brigade <hello@yourdomain.com>".
RESEND_FROM="Brad's Brigade <onboarding@resend.dev>"
